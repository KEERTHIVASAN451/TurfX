# =========================================================
# TurfX - Environment Variables Template
# Copy these values into your Render Dashboard (Environment Tab)
# =========================================================

# Flask Secret Key (use a secure random string or generate on Render)
SECRET_KEY=replace_with_a_secure_random_32_character_string

# Cloud Database URL (from Aiven, TiDB Cloud, Railway, or Clever Cloud)
# Format: mysql://<username>:<password>@<hostname>:<port>/<dbname>?ssl-mode=REQUIRED
DATABASE_URL=mysql://username:password@host:port/database

# OR use individual MySQL parameters if your provider provides them separately:
# MYSQL_HOST=your-cloud-host.com
# MYSQL_PORT=3306
# MYSQL_USER=your-db-user
# MYSQL_PASSWORD=your-db-password
# MYSQL_DB=turfx

# Role configuration
USER_ROLE_ID=2
ADMIN_ROLE_ID=1

# Email configuration (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_16_char_app_password
ADMIN_EMAIL=your_gmail_address@gmail.com

# Debug flag (keep false in production)
FLASK_DEBUG=false
